#include <iostream>
#include <fstream>
#include <iomanip>
#include <string>

using namespace std;

class Book {
private:
    int bookID;
    string title;
    string author;
    bool issued;

public:

    void addBook() {

        cout << "\nEnter Book ID: ";
        cin >> bookID;
        cin.ignore();

        cout << "Enter Book Title: ";
        getline(cin, title);

        cout << "Enter Author Name: ";
        getline(cin, author);

        issued = false;
    }

    void displayBook() const {

        cout << left << setw(15) << bookID
             << setw(30) << title
             << setw(25) << author
             << setw(15) << (issued ? "Issued" : "Available")
             << endl;
    }

    int getBookID() const {
        return bookID;
    }

    string getTitle() const {
        return title;
    }

    string getAuthor() const {
        return author;
    }

    bool isIssued() const {
        return issued;
    }

    void issueBook() {

        if (issued) {
            cout << "\nBook is already issued!\n";
        }
        else {
            issued = true;
            cout << "\nBook Issued Successfully!\n";
        }
    }

    void returnBook() {

        if (!issued) {
            cout << "\nBook is already available!\n";
        }
        else {
            issued = false;
            cout << "\nBook Returned Successfully!\n";
        }
    }

    void writeToFile(ofstream &outFile) const {

        outFile << bookID << endl;
        outFile << title << endl;
        outFile << author << endl;
        outFile << issued << endl;
    }

    bool readFromFile(ifstream &inFile) {

        if (!(inFile >> bookID))
            return false;

        inFile.ignore();

        getline(inFile, title);
        getline(inFile, author);

        inFile >> issued;
        inFile.ignore();

        return true;
    }
};

bool isDuplicateBook(int id) {

    Book b;

    ifstream file("library.txt");

    while (b.readFromFile(file)) {

        if (b.getBookID() == id) {

            file.close();
            return true;
        }
    }

    file.close();
    return false;
}

void addNewBook() {

    Book b;

    cout << "\n========== ADD NEW BOOK ==========\n";

    b.addBook();

    if (isDuplicateBook(b.getBookID())) {

        cout << "\nBook ID Already Exists!\n";
        return;
    }

    ofstream file("library.txt", ios::app);

    b.writeToFile(file);

    file.close();

    cout << "\nBook Added Successfully!\n";
}

void displayAllBooks() {

    Book b;

    ifstream file("library.txt");

    cout << "\n========== LIBRARY BOOKS ==========\n";

    if (!file) {

        cout << "\nNo Records Found!\n";
        return;
    }

    cout << left << setw(15) << "Book ID"
         << setw(30) << "Title"
         << setw(25) << "Author"
         << setw(15) << "Status"
         << endl;

    cout << "--------------------------------------------------------------------------\n";

    while (b.readFromFile(file)) {

        b.displayBook();
    }

    file.close();
}

void searchByTitle() {

    string searchTitle;
    bool found = false;

    Book b;

    cin.ignore();

    cout << "\nEnter Book Title to Search: ";
    getline(cin, searchTitle);

    ifstream file("library.txt");

    cout << "\n========== SEARCH RESULT ==========\n";

    while (b.readFromFile(file)) {

        if (b.getTitle() == searchTitle) {

            cout << left << setw(15) << "Book ID"
                 << setw(30) << "Title"
                 << setw(25) << "Author"
                 << setw(15) << "Status"
                 << endl;

            cout << "--------------------------------------------------------------------------\n";

            b.displayBook();

            found = true;
        }
    }

    file.close();

    if (!found) {

        cout << "\nBook Not Found!\n";
    }
}

void searchByAuthor() {

    string searchAuthor;
    bool found = false;

    Book b;

    cin.ignore();

    cout << "\nEnter Author Name to Search: ";
    getline(cin, searchAuthor);

    ifstream file("library.txt");

    cout << "\n========== SEARCH RESULT ==========\n";

    while (b.readFromFile(file)) {

        if (b.getAuthor() == searchAuthor) {

            cout << left << setw(15) << "Book ID"
                 << setw(30) << "Title"
                 << setw(25) << "Author"
                 << setw(15) << "Status"
                 << endl;

            cout << "--------------------------------------------------------------------------\n";

            b.displayBook();

            found = true;
        }
    }

    file.close();

    if (!found) {

        cout << "\nBooks by this author not found!\n";
    }
}

void issueBook() {

    int id;
    bool found = false;

    Book b;

    cout << "\nEnter Book ID to Issue: ";
    cin >> id;

    ifstream file("library.txt");
    ofstream temp("temp.txt");

    while (b.readFromFile(file)) {

        if (b.getBookID() == id) {

            b.issueBook();
            found = true;
        }

        b.writeToFile(temp);
    }

    file.close();
    temp.close();

    remove("library.txt");
    rename("temp.txt", "library.txt");

    if (!found) {

        cout << "\nBook Not Found!\n";
    }
}

void returnBook() {

    int id;
    bool found = false;

    Book b;

    cout << "\nEnter Book ID to Return: ";
    cin >> id;

    ifstream file("library.txt");
    ofstream temp("temp.txt");

    while (b.readFromFile(file)) {

        if (b.getBookID() == id) {

            b.returnBook();
            found = true;
        }

        b.writeToFile(temp);
    }

    file.close();
    temp.close();

    remove("library.txt");
    rename("temp.txt", "library.txt");

    if (!found) {

        cout << "\nBook Not Found!\n";
    }
}

int main() {

    int choice;

    do {

        cout << "\n\n========== LIBRARY MANAGEMENT SYSTEM ==========\n";

        cout << "1. Add New Book\n";
        cout << "2. Display All Books\n";
        cout << "3. Search Book by Title\n";
        cout << "4. Search Book by Author\n";
        cout << "5. Issue Book\n";
        cout << "6. Return Book\n";
        cout << "7. Exit\n";

        cout << "\nEnter Your Choice: ";
        cin >> choice;

        switch (choice) {

        case 1:
            addNewBook();
            break;

        case 2:
            displayAllBooks();
            break;

        case 3:
            searchByTitle();
            break;

        case 4:
            searchByAuthor();
            break;

        case 5:
            issueBook();
            break;

        case 6:
            returnBook();
            break;

        case 7:
            cout << "\nThank You! Exiting Program...\n";
            break;

        default:
            cout << "\nInvalid Choice! Please Try Again.\n";
        }

    } while (choice != 7);

    return 0;
}
